DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grantos
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reserved for future paid web research. Both providers are disabled in code.
# Daily direct discovery does not use these keys or any AI provider.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Legacy setting; no longer grants editor access. Use verified database roles.
CATALOG_EDITOR_EMAILS=

# Hosted beta (production always enforces beta access).
BETA_MODE=false
APP_URL=
AUTH_URL=
SUPPORT_EMAIL=
GMAIL_SENDER=tobias.fletch@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_OAUTH_PRODUCTION_CONFIRMED=false
EMAIL_ENABLED=false
TRUST_PROXY=
# Direct owner connection, used only for controlled migrations.
MIGRATION_DATABASE_URL=
# Separate restricted direct connection for the local crawler.
DISCOVERY_DATABASE_URL=
# Supply backup encryption key separately from database credentials.
BACKUP_KEY=

# Bounded cloud worker; local continuous worker ignores this limit.
DISCOVERY_MAX_SECONDS=840
